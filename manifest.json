{
  "manifest_version": 3,
  "name": "Snip In Browser",
  "version": "1.3.0",
  "description": "Professional in-browser snipping tool.",
  "icons": {
    "16": "icons/snipper.png",
    "48": "icons/snipper.png",
    "128": "icons/snipper.png",
    "512": "icons/snipper.png"
  },
  "action": {
    "default_title": "Snip In Browser",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/snipper.png",
      "24": "icons/snipper.png",
      "32": "icons/snipper.png"
    }
  },
  "permissions": [
    "activeTab",
    "scripting",
    "tabs",
    "clipboardWrite",
    "storage"
  ],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "start-snip": {
      "suggested_key": {
        "default": "Ctrl+Shift+S",
        "mac": "Command+Shift+S"
      },
      "description": "Toggle Snipping Tool"
    }
  }
}
